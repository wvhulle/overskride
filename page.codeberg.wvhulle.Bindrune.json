{
    "app-id" : "page.codeberg.wvhulle.Bindrune",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "49",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "bindrune",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--allow=bluetooth",
        "--socket=system-bus",
        "--socket=session-bus",
        "--filesystem=xdg-run/gvfsd",
        "--talk-name=org.gtk.vfs.*"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "RUST_BACKTRACE" : "1"
        }
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "bindrune",
            "buildsystem" : "simple",
            "build-commands" : [
                "cargo build --release --locked --package bindrune-gtk",
                "make install-binary install-data PREFIX=/app"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".",
                    "skip" : [
                        "target",
                        "build",
                        "result",
                        ".direnv",
                        ".flatpak-builder"
                    ]
                }
            ]
        }
    ]
}
